include LICENSE NOTICE README.md CONTRIBUTING.md
include uv.lock .env.example compose.yaml compose.dev.yaml Dockerfile
recursive-include static *.html *.js *.css *.svg *.png
recursive-include sql *.sql *.md
recursive-include scripts *.py *.cjs *.ts
recursive-include tests *.py *.gz *.ts *.tsx *.json *.md LICENSE COMMIT
recursive-include docs *.md
recursive-include deploy *.conf *.inc *.service *.timer *.sh *.md
prune deploy/certbot
exclude src/ziwei/data/tianji_catalog.json
global-exclude *.pyc .DS_Store
