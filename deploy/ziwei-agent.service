[Unit]
Description=Ziwei Agent (uv / FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ziwei-agent
Environment=UV_PYTHON_INSTALL_DIR=/home/ziwei-agent/.python
ExecStart=/home/ziwei-agent/.tools/bin/uv run --no-sync --env-file /home/ziwei-agent/.env uvicorn ziwei.api:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1,172.18.0.0/16
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
